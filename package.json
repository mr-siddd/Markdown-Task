{
  "name": "pre-marknotes",
  "version": "1.0.0",
  "description": "A Markdown Notes Desktop App",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build-electron": "tsc -p tsconfig.electron.json",
    "electron": "npm run build-electron && electron .",
    "electron-dev": "npm run build-electron && cross-env NODE_ENV=development electron .",
    "postinstall": "npm run build-electron",
    "prestart": "npm run build",
    "poststart": "npm run electron",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron-dev\""
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0"
  },
  "keywords": [
    "markdown",
    "notes",
    "electron"
  ],
  "author": "Your Name",
  "license": "MIT"
}
